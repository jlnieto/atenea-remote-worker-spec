{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.internal/contracts/agent-run-project-codex-v4.request.schema.json",
  "title": "Atenea exact development-change-owned project Codex dispatch request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatchId", "sessionId", "workspaceIdentity", "workloadClass",
    "leaseGeneration", "changeOwnership", "workload"
  ],
  "properties": {
    "dispatchId": {"type": "string", "format": "uuid"},
    "sessionId": {"type": "string", "format": "uuid"},
    "workspaceIdentity": {
      "type": "string",
      "pattern": "^remote:ax42-01:change:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workloadClass": {"enum": ["NORMAL", "HEAVY"]},
    "leaseGeneration": {"type": "integer", "minimum": 1},
    "changeOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeKey", "databaseWorkSessionId", "remoteSessionId",
        "workspaceIdentity", "databaseProjectId", "baseCommit",
        "expectedCanonicalCommit", "sourceRevision",
        "sourceFingerprintSha256", "workspaceOwnershipFingerprintSha256"
      ],
      "properties": {
        "changeKey": {"type": "string", "format": "uuid"},
        "databaseWorkSessionId": {"type": "integer", "minimum": 1},
        "remoteSessionId": {"type": "string", "format": "uuid"},
        "workspaceIdentity": {
          "type": "string",
          "pattern": "^remote:ax42-01:change:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "databaseProjectId": {"type": "integer", "minimum": 1},
        "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expectedCanonicalCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourceRevision": {"type": "integer", "minimum": 0},
        "sourceFingerprintSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workspaceOwnershipFingerprintSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "projectId", "repository", "branch", "commit",
        "manifestSha256", "instructionBundleRevision", "instructionBundleSha256",
        "platformInstructionSha256", "projectInstructionPath",
        "projectInstructionSha256", "modelId", "reasoningEffort",
        "catalogRevision", "codexVersion", "message", "threadId", "attachments"
      ],
      "properties": {
        "kind": {"const": "project-codex-v4"},
        "projectId": {"const": "atenea"},
        "repository": {"const": "https://github.com/jlnieto/atenea.git"},
        "branch": {"const": "main"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "instructionBundleRevision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "instructionBundleSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platformInstructionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "projectInstructionPath": {"const": "AGENTS.md"},
        "projectInstructionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modelId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "reasoningEffort": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]},
        "catalogRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "codexVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 20000},
        "threadId": {"type": ["string", "null"], "format": "uuid"},
        "attachments": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attachmentId", "contentType", "sizeBytes", "sha256"],
            "properties": {
              "attachmentId": {"type": "string", "format": "uuid"},
              "contentType": {"enum": ["image/png", "image/jpeg", "image/webp"]},
              "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
