{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.local/contracts/closed-validation-start-v1.request.schema.json",
  "title": "Closed validation durable start v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolVersion", "operationId", "sessionId",
    "workspaceIdentity", "projectId", "repository", "branch", "commit",
    "manifestSha256", "operation", "definitionRevision",
    "sourceTreeFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "protocolVersion": {"const": "closed-validation-broker/v1"},
    "operationId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$"},
    "sessionId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$"},
    "workspaceIdentity": {"type": "string", "pattern": "^remote:[a-zA-Z0-9._-]{1,80}:work-session:[0-9a-f-]{36}$"},
    "projectId": {"const": "atenea"},
    "repository": {"const": "https://github.com/jlnieto/atenea.git"},
    "branch": {"const": "main"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {
      "enum": ["BACKEND_TEST", "WEB_BUILD", "ANDROID_BUILD", "PLAYWRIGHT_ACCEPTANCE"]
    },
    "definitionRevision": {
      "enum": [
        "atenea-backend-test-v1", "atenea-web-build-v1",
        "atenea-android-build-v1", "atenea-playwright-acceptance-v1"
      ]
    },
    "sourceTreeFingerprintSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "BACKEND_TEST"}}},
      "then": {"properties": {"definitionRevision": {"const": "atenea-backend-test-v1"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "WEB_BUILD"}}},
      "then": {"properties": {"definitionRevision": {"const": "atenea-web-build-v1"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "ANDROID_BUILD"}}},
      "then": {"properties": {"definitionRevision": {"const": "atenea-android-build-v1"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "PLAYWRIGHT_ACCEPTANCE"}}},
      "then": {"properties": {"definitionRevision": {"const": "atenea-playwright-acceptance-v1"}}}
    }
  ]
}
