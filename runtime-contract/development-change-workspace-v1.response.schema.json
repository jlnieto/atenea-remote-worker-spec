{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.local/contracts/development-change-workspace-v1.response.schema.json",
  "title": "Development change workspace v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolVersion", "state", "effect", "operationId",
    "idempotencyKey", "operation", "predecessorOperationId", "changeKey",
    "databaseProjectId", "projectId", "repository", "repositoryBranch",
    "baseCommit", "workspaceBranch",
    "workspaceIdentity", "workerId", "sourceRevision",
    "sourceCommit", "sourceFingerprintSha256", "workspaceDirty", "retainedDraft",
    "requestFingerprintSha256", "valuesExposed"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "protocolVersion": {"const": "development-change-workspace/v1"},
    "state": {"enum": ["ABSENT", "OWNED", "FOREIGN"]},
    "effect": {"enum": ["CREATE_IF_ABSENT_EXACT", "OBSERVE_ONLY"]},
    "operationId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["PROVISION", "INSPECT", "RECONCILE"]},
    "predecessorOperationId": {"type": ["string", "null"], "format": "uuid"},
    "changeKey": {"type": "string", "format": "uuid"},
    "databaseProjectId": {"type": "integer", "minimum": 1},
    "projectId": {"const": "atenea"},
    "repository": {"const": "https://github.com/jlnieto/atenea.git"},
    "repositoryBranch": {"const": "main"},
    "baseCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "workspaceBranch": {"type": "string", "pattern": "^atenea/change-[0-9a-f-]{36}$"},
    "workspaceIdentity": {"type": "string", "pattern": "^remote:ax42-01:change:[0-9a-f-]{36}$"},
    "workerId": {"const": "ax42-01"},
    "sourceRevision": {"type": "integer", "minimum": 0},
    "sourceCommit": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "sourceFingerprintSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "workspaceDirty": {"type": ["boolean", "null"]},
    "retainedDraft": {"type": ["boolean", "null"]},
    "requestFingerprintSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "valuesExposed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "OWNED"}}},
      "then": {
        "properties": {
          "sourceCommit": {"type": "string"},
          "workspaceDirty": {"type": "boolean"},
          "retainedDraft": {"type": "boolean"}
        }
      },
      "else": {
        "properties": {
          "sourceCommit": {"type": "null"},
          "sourceFingerprintSha256": {"type": "null"},
          "workspaceDirty": {"type": "null"},
          "retainedDraft": {"type": "null"}
        }
      }
    }
  ]
}
