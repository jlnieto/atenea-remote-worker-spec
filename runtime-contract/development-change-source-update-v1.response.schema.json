{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.local/contracts/development-change-source-update-v1.response.schema.json",
  "title": "Pinned owned change source preparation v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "effect",
    "operationId",
    "idempotencyKey",
    "operation",
    "changeKey",
    "databaseProjectId",
    "projectId",
    "repository",
    "repositoryBranch",
    "baseCommit",
    "sourceCommit",
    "targetMainCommit",
    "workspaceBranch",
    "workspaceIdentity",
    "workerId",
    "sourceRevision",
    "sourceFingerprintSha256",
    "publicationReceiptSha256",
    "requestFingerprintSha256",
    "state",
    "preparedTreeSha",
    "conflictFiles",
    "preparedFingerprintSha256",
    "receiptSha256",
    "valuesExposed"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": "development-change-source-update/v1"
    },
    "effect": {
      "enum": [
        "PREPARE_PINNED_MAIN",
        "OBSERVE_ONLY",
        "OBSERVE_OR_RESUME_EXACT"
      ]
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "idempotencyKey": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "PREPARE",
        "INSPECT",
        "RECONCILE"
      ]
    },
    "changeKey": {
      "type": "string",
      "format": "uuid"
    },
    "databaseProjectId": {
      "type": "integer",
      "minimum": 1
    },
    "projectId": {
      "const": "atenea"
    },
    "repository": {
      "const": "https://github.com/jlnieto/atenea.git"
    },
    "repositoryBranch": {
      "const": "main"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "targetMainCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "workspaceBranch": {
      "type": "string",
      "pattern": "^atenea/change-[0-9a-f-]{36}$"
    },
    "workspaceIdentity": {
      "type": "string",
      "pattern": "^remote:ax42-01:change:[0-9a-f-]{36}$"
    },
    "workerId": {
      "const": "ax42-01"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0
    },
    "sourceFingerprintSha256": {
      "type": "null"
    },
    "publicationReceiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestFingerprintSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "ABSENT",
        "PREPARED",
        "NEEDS_RESOLUTION",
        "READY_TO_FINALIZE"
      ]
    },
    "preparedTreeSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "conflictFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    },
    "preparedFingerprintSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiptSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "valuesExposed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "PREPARE"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "PREPARE_PINNED_MAIN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "INSPECT"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "OBSERVE_ONLY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "RECONCILE"
          }
        }
      },
      "then": {
        "properties": {
          "effect": {
            "const": "OBSERVE_OR_RESUME_EXACT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ABSENT"
          }
        }
      },
      "then": {
        "properties": {
          "preparedTreeSha": {
            "type": "null"
          },
          "preparedFingerprintSha256": {
            "type": "null"
          },
          "receiptSha256": {
            "type": "null"
          },
          "conflictFiles": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "preparedTreeSha": {
            "type": "string"
          },
          "receiptSha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PREPARED"
          }
        }
      },
      "then": {
        "properties": {
          "preparedFingerprintSha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "NEEDS_RESOLUTION"
          }
        }
      },
      "then": {
        "properties": {
          "conflictFiles": {
            "minItems": 1
          },
          "preparedFingerprintSha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "READY_TO_FINALIZE"
          }
        }
      },
      "then": {
        "properties": {
          "conflictFiles": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
