{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.local/contracts/development-change-source-finalization-v1.response.schema.json",
  "title": "Exact source finalization v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "effect", "operationId", "idempotencyKey", "operation", "changeKey", "databaseProjectId", "projectId", "repository", "repositoryBranch", "baseCommit", "sourceCommit", "targetMainCommit", "workspaceBranch", "workspaceIdentity", "workerId", "sourceRevision", "sourceFingerprintSha256", "publicationReceiptSha256", "preparationOperationId", "preparationReceiptSha256", "validationProjectionSha256", "requestFingerprintSha256", "state", "publishedHeadSha", "expectedTreeSha", "finalizationReceiptSha256", "valuesExposed"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "protocolVersion": {"const": "development-change-source-finalization/v1"},
    "effect": {"enum": ["FINALIZE_VALIDATED_SOURCE", "OBSERVE_ONLY", "RESUME_PINNED_SOURCE"]},
    "operation": {"enum": ["FINALIZE", "INSPECT", "RECOVER"]},
    "operationId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {"type": "string", "format": "uuid"},
    "changeKey": {"type": "string", "format": "uuid"},
    "databaseProjectId": {"type": "integer", "minimum": 1},
    "projectId": {"const": "atenea"},
    "repository": {"const": "https://github.com/jlnieto/atenea.git"},
    "repositoryBranch": {"const": "main"},
    "baseCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "sourceCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "targetMainCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "workspaceBranch": {"type": "string", "pattern": "^atenea/change-[0-9a-f-]{36}$"},
    "workspaceIdentity": {"type": "string", "pattern": "^remote:ax42-01:change:[0-9a-f-]{36}$"},
    "workerId": {"const": "ax42-01"},
    "sourceRevision": {"type": "integer", "minimum": 1},
    "sourceFingerprintSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "publicationReceiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preparationOperationId": {"type": "string", "format": "uuid"},
    "preparationReceiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validationProjectionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestFingerprintSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["ABSENT", "PREPARED", "PUBLISHED"]},
    "publishedHeadSha": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "expectedTreeSha": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "finalizationReceiptSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "valuesExposed": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "RECOVER"}}}, "then": {"properties": {"effect": {"const": "RESUME_PINNED_SOURCE"}, "state": {"const": "PUBLISHED"}}}},
    {"if": {"properties": {"operation": {"const": "FINALIZE"}}}, "then": {"properties": {"effect": {"const": "FINALIZE_VALIDATED_SOURCE"}, "state": {"const": "PUBLISHED"}}}},
    {"if": {"properties": {"operation": {"const": "INSPECT"}}}, "then": {"properties": {"effect": {"const": "OBSERVE_ONLY"}}}},
    {"if": {"properties": {"state": {"const": "ABSENT"}}}, "then": {"properties": {"operation": {"const": "INSPECT"}, "publishedHeadSha": {"type": "null"}, "expectedTreeSha": {"type": "null"}, "finalizationReceiptSha256": {"type": "null"}}}, "else": {"properties": {"publishedHeadSha": {"type": "string"}, "expectedTreeSha": {"type": "string"}}}},
    {"if": {"properties": {"state": {"const": "PUBLISHED"}}}, "then": {"properties": {"finalizationReceiptSha256": {"type": "string"}}}, "else": {"properties": {"finalizationReceiptSha256": {"type": "null"}}}}
  ]
}
