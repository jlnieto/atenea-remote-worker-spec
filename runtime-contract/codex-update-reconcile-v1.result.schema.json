    "operation": {"const": "RECONCILE_INSTALLED_CODEX_RELEASES"},
    "workerId": {"const": "ax42-01"},
    "idempotencyKey": {"type": "string", "format": "uuid"},
    "state": {"const": "RECONCILED"},
    "planId": {"const": "15414500-0000-4000-8000-000000000001"},
    "currentInventoryId": {"const": "15414500-0000-4000-8000-000000000002"},
    "candidateInventoryId": {"const": "15414500-0000-4000-8000-000000000003"},
    "currentVersion": {"const": "0.154.0"},
    "candidateVersion": {"const": "0.145.0"},
    "currentReleaseDigestSha256": {"const": "37de474b157b0313c73ddc05928855f61517676138827df51660fe8715dca14f"},
    "candidateReleaseDigestSha256": {"const": "56da3312ccb2109a2f4e0d71b003f08d33244ec6f5863e8fc7f6f24b7a6489c2"},
    "candidateCatalogRevision": {"const": "125b9437e38f83e04cb10996fc70d3ab44c32082009b8e897cb08bb340b13187"},
    "currentInstallationState": {"const": "INSTALLED"},
    "currentLinkState": {"const": "CURRENT"},
    "currentCompatibilityState": {"const": "UNKNOWN"},
    "candidateInstallationState": {"const": "STAGED"},
    "candidateLinkState": {"const": "NONE"},
    "candidateCompatibilityState": {"const": "COMPATIBLE"},
    "previousState": {"const": "ABSENT"},
    "previousCompatibilityState": {"const": "UNKNOWN"},
    "structureVerification": {"const": "PASS"},
    "permissionVerification": {"const": "PASS"},
    "metadataVerification": {"const": "PASS"},
    "versionVerification": {"const": "PASS"},
    "hashVerification": {"const": "PASS"},
    "zeroNonTerminalRuns": {"const": "PASS"},
    "currentLinkFingerprint": {"$ref": "#/$defs/digest"},
    "linksChanged": {"type": "boolean"},
    "inventorySha256": {"$ref": "#/$defs/digest"},
    "planSha256": {"$ref": "#/$defs/digest"},
    "registrySha256": {"$ref": "#/$defs/digest"},
    "valuesExposed": {"const": false},
    "completedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
