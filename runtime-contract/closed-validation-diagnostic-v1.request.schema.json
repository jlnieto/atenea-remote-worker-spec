{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atenea.local/contracts/closed-validation-diagnostic-v1.request.schema.json",
  "title": "Read one retained sealed validation diagnostic; no execution",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "operationId", "sessionId", "workspaceIdentity", "projectId"],
  "properties": {
    "schemaVersion": {"const": 1},
    "protocolVersion": {"const": "closed-validation-broker/v1"},
    "operationId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$"},
    "sessionId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$"},
    "workspaceIdentity": {"type": "string", "pattern": "^remote:ax42-01:(change|work-session):[0-9a-f-]{36}$"},
    "projectId": {"const": "atenea"}
  }
}
